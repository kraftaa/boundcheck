{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kraftaa/boundcheck/blob/main/schemas/report-v1.schema.json",
  "title": "boundarycheck report v1",
  "type": "object",
  "required": [
    "schema_version",
    "boundarycheck_version",
    "run_id",
    "adapter",
    "runtime",
    "provider_protocol",
    "command",
    "platform",
    "scenarios",
    "summary",
    "exit"
  ],
  "properties": {
    "schema_version": {"const": "boundarycheck.report/v1"},
    "boundarycheck_version": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^BC_RUN_[0-9]{6}$"},
    "started_at": {"type": "string"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "provider_protocol": {"enum": ["openai-chat-completions", "openai-responses"]},
    "adapter": {"$ref": "#/$defs/adapter"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "command": {
      "type": "object",
      "required": ["argv"],
      "properties": {"argv": {"type": "array", "items": {"type": "string"}}}
    },
    "platform": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {"os": {"type": "string"}, "arch": {"type": "string"}}
    },
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}},
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "unknown"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {"type": "string"},
    "workdir": {"type": "string"},
    "harness_error": {"type": "string"},
    "isolation": {"type": "string"},
    "exit": {
      "type": "object",
      "required": ["code", "classification"],
      "properties": {
        "code": {"type": "integer", "minimum": 0, "maximum": 3},
        "classification": {"enum": ["all-passed", "failures", "unknowns", "harness-error"]}
      }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {"name": {"type": "string"}, "source": {"type": "string"}}
    },
    "runtime": {
      "type": "object",
      "required": ["name", "version", "version_source"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "version_source": {"type": "string"},
        "details": {}
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id", "summary", "verdict", "classifications", "unknowns", "notes",
        "calls", "provider_requests", "state_machine", "process", "duration_ms"
      ],
      "properties": {
        "id": {"type": "string"},
        "summary": {"type": "string"},
        "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "classifications": {"type": "array", "items": {"type": "string"}},
        "unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "detail"],
            "properties": {"reason": {"type": "string"}, "detail": {"type": "string"}}
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}},
        "calls": {"type": "array"},
        "provider_requests": {"type": "array"},
        "state_machine": {"type": "object"},
        "process": {"type": "object"},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
